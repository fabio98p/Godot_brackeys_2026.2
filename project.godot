; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="brackeys_2026.2"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GS="*res://GlobalScripts/GS.gd"
Utils="*res://GlobalScripts/Utils.gd"
DialogueManager="*uid://c3rodes2l3gxb"
Story="*uid://cglf02seovrc8"

[display]

window/size/resizable=false
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/nexus_importer/plugin.cfg")

[file_customization]

folder_colors={
"res://Assets/": "yellow",
"res://GlobalScripts/": "pink",
"res://Hud/": "purple",
"res://Levels/": "orange",
"res://Menus/": "blue",
"res://NPC/": "red",
"res://Player/": "green"
}

[global_group]

level=""
player=""

