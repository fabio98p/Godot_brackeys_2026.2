; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Cold Wash"
run/main_scene="uid://b54jlkcpuwlqx"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GS="*res://GlobalScripts/GS.gd"
Utils="*res://GlobalScripts/Utils.gd"
DialogueManager="*uid://c3rodes2l3gxb"
Story="*uid://cglf02seovrc8"

[dialogue_manager]

runtime/balloon_path="res://dialogs/style/balloon.tscn"
runtime/state_autoload_shortcuts=["Story"]

[display]

window/size/resizable=false
window/stretch/mode="viewport"
window/positional_shadow/soft_shadow_filter_quality=3

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/nexus_importer/plugin.cfg")

